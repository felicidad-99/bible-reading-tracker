# Supabase Postgres connection (use pooler string for serverless/Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[POOLER_HOST]:5432/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP for password reset (use Gmail App Password, not account password)
# Format: smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_SERVER="smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465"
EMAIL_FROM="you@gmail.com"

# Bible APIs
# Free Use Bible API (fallback; no key required)
BIBLE_API_URL="https://bible.helloao.org"

# YouVersion Platform App Key (primary when set)
# Get one at https://platform.youversion.com — leave empty to use Free Use API only
YVP_APP_KEY=""

# Bible Brain / Digital Bible Platform (optional primary audio provider)
# Get a free key at https://4.dbt.io — leave empty to use public-domain audio only
BRAIN_API_KEY=""
# Optional override (defaults to https://4.dbt.io/api)
BRAIN_API_URL=""
