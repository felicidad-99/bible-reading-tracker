# Supabase Postgres connection (use pooler string for serverless/Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[POOLER_HOST]:5432/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP for password reset (use Gmail App Password, not account password)
# Format: smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_SERVER="smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465"
EMAIL_FROM="you@gmail.com"

# Bible API (Free Use Bible API - no key required)
BIBLE_API_URL="https://bible.helloao.org"
