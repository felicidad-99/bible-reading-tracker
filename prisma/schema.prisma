generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  timezone      String    @default("UTC")
  theme         String    @default("system")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  passwordResets        PasswordReset[]
  readingPlans          ReadingPlan[]
  readingProgress       ReadingProgress[]
  notificationPrefs     NotificationPreference?
  groupsOwned           Group[]              @relation("GroupOwner")
  groupMemberships      GroupMember[]
  nudgesSent            Nudge[]              @relation("NudgeFrom")
  pushSubscriptions     PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingPlan {
  id           String   @id @default(cuid())
  userId       String
  startDate    String
  endDate      String
  durationDays Int
  frequency    Int
  translation  String   @default("BSB")
  status       String   @default("active")
  sessionTimes String[]
  groupId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group?        @relation(fields: [groupId], references: [id])
  days     ReadingDay[]
  progress ReadingProgress[]

  @@index([userId, status])
  @@index([groupId, status])
}

model ReadingDay {
  id                String  @id @default(cuid())
  planId            String
  date              String
  dayNumber         Int
  status            String  @default("not_started")
  totalChapters     Int
  completedChapters Int     @default(0)

  plan     ReadingPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]

  @@unique([planId, date])
  @@index([planId, dayNumber])
}

model ReadingSession {
  id            String    @id @default(cuid())
  readingDayId  String
  sessionNumber Int
  scheduledTime String
  status        String    @default("not_started")
  startedAt     DateTime?
  completedAt   DateTime?
  chapters      Json
  chapterCount  Int       @default(0)

  readingDay ReadingDay          @relation(fields: [readingDayId], references: [id], onDelete: Cascade)
  reads      SessionReadChapter[]

  @@unique([readingDayId, sessionNumber])
  @@index([readingDayId, sessionNumber])
}

model SessionReadChapter {
  id        String   @id @default(cuid())
  sessionId String
  bookId    String
  chapter   Int
  readAt    DateTime @default(now())

  session ReadingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, bookId, chapter])
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  planId      String
  bookId      String
  chapter     Int
  completedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, bookId, chapter])
  @@index([userId, planId])
}

model NotificationPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  enabled              Boolean @default(false)
  beforeMinutes        Int     @default(15)
  missedReminderEnabled Boolean @default(true)
  missedAfterMinutes   Int     @default(45)
  maxMissedPerSession  Int     @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id            String   @id @default(cuid())
  name          String
  createdById   String
  startDate     String
  durationDays  Int
  frequency     Int
  scheduledTimes Json
  translation   String
  inviteCode    String   @unique @default(cuid())
  createdAt     DateTime @default(now())

  createdBy User          @relation("GroupOwner", fields: [createdById], references: [id])
  members   GroupMember[]
  plans     ReadingPlan[]
  nudges    Nudge[]

  @@index([createdById])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model Nudge {
  id         String    @id @default(cuid())
  groupId    String
  fromUserId String
  toUserId   String
  date       String
  createdAt  DateTime  @default(now())
  seenAt     DateTime?

  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User           @relation("NudgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, fromUserId, toUserId, date])
  @@index([toUserId, seenAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
